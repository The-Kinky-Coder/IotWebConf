# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly mark source files as text
*.c   text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.ini  text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.bin  binary
*.elf  binary
*.a    binary
